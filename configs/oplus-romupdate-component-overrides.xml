<config>
    <!--
         Keep the local RomUpdateProvider available to Oplus components, but
         prevent the OxygenOS RUS client from receiving update broadcasts or
         starting its background update services.
    -->
    <component-override package="com.oplus.romupdate">
        <component class="com.oplusos.romupdate.receiver.UpdateReceiver" enabled="false" />
        <component class="com.oplus.romupdate.TermsOfServiceReceiver" enabled="false" />
        <component class="com.oplusos.romupdate.service.UpdateService" enabled="false" />
        <component class="com.oplusos.romupdate.service.KillSelfService" enabled="false" />
        <component class="com.oplus.ota.shelf.RUSShelfService" enabled="false" />
        <component class="com.oplusos.romupdate.service.ConnectivityJobService" enabled="false" />
    </component-override>
</config>
