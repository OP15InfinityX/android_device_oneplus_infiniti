# NXP Weaver stores its slots in the embedded secure element through OMAPI.
binder_call(hal_weaver_default, secure_element)
allow hal_weaver_default secure_element_service:service_manager find;

allow hal_weaver_default self:capability2 wake_alarm;
get_prop(hal_weaver_default, boot_status_prop)
wakelock_use(hal_weaver_default)
