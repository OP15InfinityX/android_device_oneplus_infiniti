attribute dvs_aidl;
attribute dvs_aidl_client;
attribute dvs_aidl_server;

type dvs_aidl_default, domain;
type dvs_aidl_default_exec, exec_type, vendor_file_type, file_type;
type dvs_aidl_service, service_manager_type;

typeattribute dvs_aidl_default dvs_aidl;
typeattribute dvs_aidl_default dvs_aidl_server;

typeattribute hal_graphics_composer_default dvs_aidl_client;
typeattribute mediaserver dvs_aidl_client;
typeattribute platform_app dvs_aidl_client;
typeattribute priv_app dvs_aidl_client;
typeattribute surfaceflinger dvs_aidl_client;
typeattribute system_app dvs_aidl_client;
typeattribute untrusted_app dvs_aidl_client;
typeattribute untrusted_app_25 dvs_aidl_client;
typeattribute untrusted_app_27 dvs_aidl_client;
typeattribute untrusted_app_29 dvs_aidl_client;
typeattribute untrusted_app_30 dvs_aidl_client;
typeattribute untrusted_app_32 dvs_aidl_client;

binder_call(dvs_aidl_client, dvs_aidl_server)
binder_call(dvs_aidl_server, dvs_aidl_client)
set_prop(dvs_aidl_server, vendor_dolbyv_prop)
allow dvs_aidl_client dvs_aidl_service:service_manager find;

init_daemon_domain(dvs_aidl_default)
binder_use(dvs_aidl_default)
binder_call(dvs_aidl_default, system_server)
add_service(dvs_aidl_default, dvs_aidl_service)

allow dvs_aidl_default fwk_sensor_hwservice:hwservice_manager find;
allow dvs_aidl_default fwk_sensor_service:service_manager find;
allow dvs_aidl_default vendor_sysfs_graphics:dir { read open search };
allow dvs_aidl_default vendor_sysfs_graphics:file { read getattr open };
